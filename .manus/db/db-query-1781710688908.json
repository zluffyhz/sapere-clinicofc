{
  "query": "-- Séries de REGINA que começaram na primeira semana de junho - verificar se cobrem semana 3+\nSELECT a.seriesId, COUNT(*) as total, MIN(DATE(a.startTime)) as firstDate, MAX(DATE(a.startTime)) as lastDate\nFROM appointments a\nWHERE a.therapistUserId = 4620148\nAND a.seriesId IS NOT NULL\nAND a.seriesId IN (\n  SELECT DISTINCT seriesId FROM appointments \n  WHERE therapistUserId = 4620148 \n  AND DATE(startTime) BETWEEN '2026-06-01' AND '2026-06-07'\n  AND seriesId IS NOT NULL\n)\nGROUP BY a.seriesId\nORDER BY firstDate;",
